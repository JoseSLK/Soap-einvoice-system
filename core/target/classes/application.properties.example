# Puerto por defecto
server.port=${SERVER_PORT:8080}

# Configuracion de Gmail para el envio de correos
spring.mail.host=${MAIL_HOST:smtp.gmail.com}
spring.mail.port=${MAIL_PORT:587}
spring.mail.username=${MAIL_USERNAME:tu_correo@gmail.com}
spring.mail.password=${MAIL_PASSWORD:}

# Parametros de seguridad de JavaMail para Gmail (TLS y Autenticacion)
spring.mail.properties.mail.smtp.auth=${MAIL_SMTP_AUTH:true}
spring.mail.properties.mail.smtp.starttls.enable=${MAIL_STARTTLS_ENABLE:true}
spring.mail.properties.mail.smtp.starttls.required=${MAIL_STARTTLS_REQUIRED:true}

# Logs de WS si es necesario
logging.level.org.springframework.ws=${WS_LOG_LEVEL:DEBUG}
